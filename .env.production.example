# Keep the real .env file private. Token Factory credits do not pay for hosting.
OWNSTACK_ENV=production
OWNSTACK_DOMAIN=replace-with-your-owned-domain.example
OWNSTACK_PUBLIC_ORIGIN=https://replace-with-your-owned-domain.example
OWNSTACK_SIGNING_SECRET=replace-with-a-new-32-plus-character-random-secret
OWNSTACK_DEMO_PASSWORD=replace-with-a-new-16-plus-character-random-password
# Use a URL-safe random database password. An existing DB must be rotated separately.
OWNSTACK_DB_PASSWORD=replace-with-url-safe-random-password
# Existing call allowance is exhausted. This template grants no inference authority.
OWNSTACK_AI_MODE=off
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=
OWNSTACK_MAX_LIVE_CALLS=0
OWNSTACK_AI_TIMEOUT_SECONDS=60
OWNSTACK_BUILD_REVISION=uncommitted-reference
OWNSTACK_RUNTIME_DB_USER=ownstack_app
OWNSTACK_RUNTIME_DB_PASSWORD=replace-with-an-independent-runtime-role-password
# Choose a private subnet unused by the deployment host; pin both proxy addresses.
OWNSTACK_SERVICE_SUBNET=172.30.0.0/24
OWNSTACK_WEB_INTERNAL_IP=172.30.0.10
OWNSTACK_EDGE_INTERNAL_IP=172.30.0.20
