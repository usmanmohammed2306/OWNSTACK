# Local demo only. Replace both values before any shared deployment.
OWNSTACK_DATABASE_URL=postgresql+psycopg://ownstack:ownstack@localhost:5432/ownstack
OWNSTACK_SIGNING_SECRET=replace-with-at-least-32-random-characters
OWNSTACK_AI_MODE=fixture
OWNSTACK_MAX_LIVE_CALLS=0
# For a shared judge build, change this and the signing secret. Never publish either value.
OWNSTACK_DEMO_PASSWORD=demo-only-pass
# For a paid live call, first verify credits and price and explicitly opt in.
# OWNSTACK_AI_MODE=nebius
# NEBIUS_API_KEY=
# NEBIUS_MODEL_ID=choose-current-nvidia-nemotron-id-from-token-factory
# OWNSTACK_MAX_LIVE_CALLS=10
OWNSTACK_AI_TIMEOUT_SECONDS=20
# Optional independently verified coding model; defaults to NEBIUS_MODEL_ID.
NEBIUS_PATCH_MODEL_ID=
