# Local demo only. Replace both values before any shared deployment.
OWNSTACK_DATABASE_URL=postgresql+psycopg://ownstack:ownstack@localhost:5432/ownstack
# Per synchronous PostgreSQL I/O wait, including COMMIT acknowledgement.
# Timeout discards the connection; reload saved state before repeating an intent.
OWNSTACK_DB_IO_TIMEOUT_SECONDS=15
OWNSTACK_SIGNING_SECRET=replace-with-at-least-32-random-characters
OWNSTACK_AI_MODE=off
OWNSTACK_MAX_LIVE_CALLS=0
# For a shared judge build, change this and the signing secret. Never publish either value.
OWNSTACK_DEMO_PASSWORD=demo-only-pass
# This template grants no inference allowance. Preserve the authoritative ledger,
# verify provider pricing/credits and approve a budget before enabling live calls.
# OWNSTACK_AI_MODE=nebius
# NEBIUS_API_KEY=
# NEBIUS_MODEL_ID=choose-current-nvidia-nemotron-id-from-token-factory
# OWNSTACK_MAX_LIVE_CALLS=0
OWNSTACK_AI_TIMEOUT_SECONDS=20
# Opt-in native interpretation streaming. Does not enable AI or renew credits.
OWNSTACK_STREAM_INFERENCE=false
# Optional independently verified coding model; defaults to NEBIUS_MODEL_ID.
NEBIUS_PATCH_MODEL_ID=
# Explicit opt-in for anonymous creation of an isolated workspace. No AI entitlement.
OWNSTACK_PUBLIC_SIGNUP=false
# Local trained checkpoint companion, separate from all provider allowances.
# Leave disabled until installing/evaluating a verified artifact. Never expose
# the loopback companion publicly or commit its separate shared service token.
OWNSTACK_TRAINED_PLANNER_URL=
OWNSTACK_TRAINED_PLANNER_ARTIFACT_SHA256=
OWNSTACK_PLANNER_SERVICE_TOKEN=
# Opt-in single-database authorization clock guard, not distributed trusted time.
OWNSTACK_ENFORCE_AUTH_CLOCK=false
